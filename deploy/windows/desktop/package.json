{
  "name": "philosopher-stone-crm",
  "productName": "哲人石CRM",
  "version": "1.0.0",
  "description": "哲人石CRM Windows 安全桌面客户端",
  "author": "Philosopher Stone CRM",
  "private": true,
  "main": "src/main.cjs",
  "engines": { "node": ">=22.20.0 <23" },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:next": "electron-builder --win nsis --x64 --publish never --config.extraMetadata.version=1.0.1 --config.directories.output=dist-next"
  },
  "dependencies": { "electron-updater": "6.8.11" },
  "devDependencies": { "electron": "45.2.3", "electron-builder": "26.18.0" },
  "build": {
    "appId": "com.philosophersstone.crm",
    "executableName": "PhilosopherStoneCRM",
    "productName": "哲人石CRM",
    "artifactName": "PhilosopherStoneCRM-Setup-${version}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**", "package.json"],
    "extraResources": [
      { "from": "release/ota-policy.json", "to": "ota-policy.json" },
      { "from": "release/app-update.yml", "to": "app-update.yml" },
      { "from": "release/connection-policy.json", "to": "connection-policy.json" }
    ],
    "beforePack": "./scripts/prepare-release.cjs",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico", "signAndEditExecutable": true },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "哲人石CRM",
      "runAfterFinish": false,
      "include": "installer.nsh"
    }
  }
}
